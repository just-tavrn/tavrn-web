# Node
node_modules/
*.tsbuildinfo
*.tgz
# The web client's build output (pnpm --filter @tavrn/web build); released as a tarball, never committed
dist/
/release/

# Local data of the end-to-end nodes and secrets: never part of the repository
/data
data/
data-dev/
pgdata/
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
*.pem
*.key
# Bot key files and state directories of local runs
tavrn-key-*.txt
.tavrn-state*/

# Rust build output (a locally built tavrn-node for the end-to-end tests lives elsewhere; phase 6: Tauri shells)
target/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Agent settings, memory files and planning notes: never part of the repository
.claude/
CLAUDE.md
docs/PLAN.md

# Test output
test-results/
playwright-report/
blob-report/
coverage/
perf/results/
e2e/perf/results/

# Private pattern list of the pre-publication check
.publish-check.private

# The desktop shell: files tauri-build generates (capability schemas); signing keys never (*.key above)
apps/desktop/src-tauri/gen/schemas/
# The Android project (apps/desktop/src-tauri/gen/android) is committed; its build output and keystores never are
*.jks
*.keystore
keystore.properties
# The Electron shell's packages (electron-builder output)
apps/desktop-electron/release/
