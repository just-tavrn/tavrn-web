{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled web client in the main window: only the app's own commands (docs/DESKTOP.md). No remote URLs: a node never reaches the native API.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-get-config",
    "allow-set-node",
    "allow-app-info",
    "allow-open-external",
    "allow-check-update",
    "allow-install-update",
    "allow-resolve-node",
    "allow-open-connect",
    "allow-close-connect",
    "allow-keychain-get",
    "allow-keychain-set",
    "allow-keychain-delete",
    "allow-keychain-status",
    "allow-notify",
    "allow-shell-events",
    "allow-tray-set",
    "allow-tray-status",
    "allow-set-close-to-tray",
    "allow-quit-app",
    "allow-register-hotkey",
    "allow-unregister-hotkey",
    "allow-listen-hotkeys",
    "allow-set-hotkeys-enabled",
    "allow-save-file-begin",
    "allow-save-file-chunk",
    "allow-save-file-end",
    "allow-save-file-abort",
    "allow-save-file-reveal",
    "allow-voice-info",
    "allow-voice-devices",
    "allow-voice-join",
    "allow-voice-leave",
    "allow-voice-set-key",
    "allow-voice-set-muted",
    "allow-voice-set-deafened",
    "allow-voice-set-ptt",
    "allow-voice-configure",
    "allow-voice-set-volumes"
  ]
}
