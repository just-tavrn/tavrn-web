{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled web client in the main window: only the app's own commands (docs/DESKTOP.md). No remote URLs: a node never reaches the native API.",
  "windows": ["main"],
  "permissions": [
    "allow-get-config",
    "allow-set-node",
    "allow-app-info",
    "allow-open-external",
    "allow-check-update",
    "allow-install-update",
    "allow-resolve-node",
    "allow-open-connect",
    "allow-close-connect",
    "allow-register-hotkey",
    "allow-unregister-hotkey",
    "allow-listen-hotkeys"
  ]
}
